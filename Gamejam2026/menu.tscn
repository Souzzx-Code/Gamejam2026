[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.02, 0.08, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(520, 300)
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.886, 0.478, 1)
theme_override_font_sizes/font_size = 42
text = "O VAMPIRO FOI DERROTADO"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.85, 0.95, 1)
theme_override_font_sizes/font_size = 22
text = "O perseguidor venceu desta vez."
horizontal_alignment = 1

[node name="RestartButton" type="Button" parent="Center/Panel"]
custom_minimum_size = Vector2(0, 55)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "JOGAR NOVAMENTE"

[node name="ExitButton" type="Button" parent="Center/Panel"]
custom_minimum_size = Vector2(0, 55)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "SAIR"

[connection signal="pressed" from="Center/Panel/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Center/Panel/ExitButton" to="." method="_on_exit_button_pressed"]
